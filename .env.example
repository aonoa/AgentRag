SERVER_ADDR=:8080
LOG_LEVEL=info

# Optional config file path (default: config/defaults.json)
# CONFIG_FILE=config/defaults.json

# Optional environment profile overlay (default/default.json)
# APP_ENV=dev

# LLM config (maps to llm.*)
USE_OPENAI=true
OPENAI_BASE_URL=https://api.openai.com
OPENAI_LLM_BASE_URL=https://api.openai.com
OPENAI_API_KEY=your_shared_api_key_here
OPENAI_LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-5.4-mini

# Embedding config (maps to embedding.*)
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Compatibility note:
# OPENAI_BASE_URL is a fallback that applies to both LLM and Embedding base URLs.
# OPENAI_API_KEY is a fallback shared key for both clients.
# OPENAI_LLM_BASE_URL / OPENAI_EMBEDDING_BASE_URL and OPENAI_LLM_API_KEY / OPENAI_EMBEDDING_API_KEY take precedence when set.

# Retrieval
VECTOR_BACKEND=qdrant
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_USE_TLS=false
QDRANT_CHUNK_COLLECTION=rag_chunks
QDRANT_SUMMARY_COLLECTION=rag_summaries
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6
MAX_RETRY_LOOPS=3

# Reranker
RERANK_URL=https://xiaohumini.site/v1/rerank
RERANK_API_KEY=your_api_key_here
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_M=4

# Optional branches
SQL_DRIVER=sqlite
SQL_DSN=:memory:
SERPER_API_KEY=

# Orchestration controls
PLANNER_MAX_SUBQUERIES=3
ORCHESTRATOR_MAX_EXTERNAL_CALLS=2
ORCHESTRATOR_TIMEOUT_SECONDS=8
EARLY_STOP_MIN_CANDIDATES=3
EARLY_STOP_TOP_SCORE=0.045

HTTP_TIMEOUT_SECONDS=30
QDRANT_TIMEOUT_SECONDS=20
